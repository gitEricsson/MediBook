# MediBook — Environment Variables
# Copy to .env and fill in production values before deploying

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=medibook-super-secret-key-must-be-at-least-256-bits-long-for-hs256

# ─── PHI Encryption ─────────────────────────────────────
PHI_ENCRYPTION_KEY=medibook-phi-aes256-encryption-key!

# ─── Database ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
MEDIBOOK_DB_HOST=localhost
MEDIBOOK_DB_PORT=3307
MEDIBOOK_DB_NAME=medibook
MEDIBOOK_DB_USER=medibook
MEDIBOOK_DB_PASSWORD=medibook
DB_HOST=localhost
DB_PORT=3307
DB_NAME=medibook
DB_USER=medibook
DB_PASSWORD=medibook

# ─── Cassandra ──────────────────────────────────────────
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=medibook
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=cassandra

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka ──────────────────────────────────────────────
MEDIBOOK_KAFKA_BROKERS=localhost:29092
KAFKA_BROKERS=localhost:29092

# ─── Email (SMTP) ───────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Payment Providers ───────────────────────────────────
# Paystack (enabled by default, set secret key for production)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Flutterwave (set FLUTTERWAVE_ENABLED=true to enable)
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key_here

# Stripe (set STRIPE_ENABLED=true to enable)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ─── Telemedicine Video Provider ─────────────────────────
# Options: stub (default, no video), daily-co, twilio
TELEMEDICINE_PROVIDER=stub

# Daily.co (set TELEMEDICINE_PROVIDER=daily-co to enable)
DAILY_CO_API_KEY=your_daily_co_api_key_here

# Twilio Video (set TELEMEDICINE_PROVIDER=twilio to enable)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_twilio_api_secret_here

# ─── AI / Clinical NLP ───────────────────────────────────
# Options: stub (default), claude-api, aws-comprehend
INTELLIGENCE_NLP_PROVIDER=stub
# Claude API (set INTELLIGENCE_NLP_PROVIDER=claude-api)
CLAUDE_API_KEY=sk-ant-your_claude_api_key_here

# ─── Super Admin Bootstrap ────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@hospital.example.com
SUPER_ADMIN_PASSWORD=Change_Me_In_Production_1!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PHONE=

# ─── Monnify Payment Gateway ─────────────────────────────────────────────
MONNIFY_ENABLED=false
# Sandbox keys from https://app.monnify.com/developer/sdk
MONNIFY_API_KEY=MK_TEST_your_api_key_here
MONNIFY_SECRET_KEY=your_monnify_secret_key_here
MONNIFY_CONTRACT_CODE=your_contract_code_here
# Sandbox: https://sandbox.monnify.com  |  Live: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_REDIRECT_URL=http://localhost:3000/payment/callback
