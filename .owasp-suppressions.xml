<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppressions for MediBook.

  Every suppression below must include:
    • the CVE / GHSA being suppressed,
    • the affected dependency,
    • a written rationale (why the CVE doesn't apply to *this* deployment),
    • a sunset date (after which the suppression must be re-evaluated).

  We never suppress without a reason. Vulnerabilities that DO apply must be
  fixed by upgrading the dependency, not silenced here.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

  <!--
    ── Swagger UI / DOMPurify CVEs ────────────────────────────────────────
    The DOMPurify CVEs (CVE-2024-45801, CVE-2024-47875, CVE-2025-26791,
    CVE-2026-41238/9/40, GHSA-39q2-94rc-95cp, GHSA-cj63-jhhr-wcxv,
    GHSA-cjmm-f4jc-qw8r, GHSA-h8r8-wccr-v5f2) live in swagger-ui's bundled
    JS. In our deployment, /swagger-ui is gated behind admin auth and not
    reachable by an unauthenticated attacker, so the DOM-based XSS surface
    is not exposed. Suppress until springdoc-openapi ships a swagger-ui
    bundle with a patched DOMPurify (tracking upstream).
    Sunset: 2026-09-01
  -->
  <suppress>
    <notes><![CDATA[
      DOMPurify inside swagger-ui-bundle is gated behind admin auth; not
      reachable by an unauthenticated attacker. Re-evaluate after 2026-09-01.
    ]]></notes>
    <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
    <cve>CVE-2024-45801</cve>
    <cve>CVE-2024-47875</cve>
    <cve>CVE-2025-26791</cve>
    <cve>CVE-2026-41238</cve>
    <cve>CVE-2026-41239</cve>
    <cve>CVE-2026-41240</cve>
  </suppress>
  <suppress>
    <notes><![CDATA[
      GHSA advisories for swagger-ui DOMPurify — same rationale as above.
      Sunset: 2026-09-01.
    ]]></notes>
    <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
    <vulnerabilityName>GHSA-39q2-94rc-95cp</vulnerabilityName>
    <vulnerabilityName>GHSA-cj63-jhhr-wcxv</vulnerabilityName>
    <vulnerabilityName>GHSA-cjmm-f4jc-qw8r</vulnerabilityName>
    <vulnerabilityName>GHSA-h8r8-wccr-v5f2</vulnerabilityName>
  </suppress>

  <!--
    ── Prometheus simpleclient_tracer_otel_agent vs OpenTelemetry CVEs ────
    CVE-2023-43810, CVE-2023-45142, CVE-2023-47108 are OpenTelemetry
    *Collector* CVEs (Go). The Prometheus Java tracer shim is mis-matched
    to the OpenTelemetry CPE by dependency-check because of an ambiguous
    coordinate — it does not run any Go code and is not the OTel collector.
    Sunset: 2026-09-01 (re-evaluate when migrating off simpleclient).
  -->
  <suppress>
    <notes><![CDATA[
      Mis-mapped CPE: simpleclient_tracer_otel_agent (Java shim) is not the
      OTel Collector (Go). The listed CVEs do not affect this artifact.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/io\.prometheus/simpleclient_tracer_otel_agent@.*$</packageUrl>
    <cve>CVE-2023-43810</cve>
    <cve>CVE-2023-45142</cve>
    <cve>CVE-2023-47108</cve>
    <cve>CVE-2026-39882</cve>
    <cve>CVE-2026-39883</cve>
    <cve>CVE-2026-40894</cve>
    <cve>CVE-2026-41078</cve>
  </suppress>

  <!--
    ── OpenTelemetry alpha CPE mismatches ──────────────────────────────
    The opentelemetry-api / opentelemetry-api-events / opentelemetry-semconv
    artifacts get matched against the OpenTelemetry *Collector* CPE.
    Same mis-mapping as above — these are Java SDK API jars, not the Go
    collector binary.
    Sunset: 2026-09-01.
  -->
  <suppress>
    <notes><![CDATA[
      opentelemetry-api / -api-events / -semconv jars are mis-mapped to the
      OTel Collector CPE. The flagged CVEs are Collector-specific.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/io\.opentelemetry(\.semconv)?/.*$</packageUrl>
    <cve>CVE-2026-39882</cve>
    <cve>CVE-2026-39883</cve>
  </suppress>

  <!--
    ── Threetenbp CVE-2024-23081 ──────────────────────────────────────────
    Comes in via google-cloud-storage. The CVE concerns a regex DoS in
    LocalDate parsing of untrusted input. We do not parse any user-supplied
    date strings through threetenbp — all date parsing goes through
    java.time directly. No exploitable code path.
    Sunset: 2026-09-01 (or when GCS drops threetenbp, whichever first).
  -->
  <suppress>
    <notes><![CDATA[
      threetenbp date parsing is not used on any user-input path in MediBook.
      No exploitable surface.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/org\.threeten/threetenbp@.*$</packageUrl>
    <cve>CVE-2024-23081</cve>
  </suppress>

</suppressions>
