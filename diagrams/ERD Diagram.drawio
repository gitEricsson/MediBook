uences&lt;br&gt;outbox_events" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2577" y="400" width="350" height="180" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-virtual" value="Telemedicine, Chat &amp;amp; AI&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;telemedicine_sessions&lt;br&gt;call_participants&lt;br&gt;chat_messages&lt;br&gt;chat_conversations&lt;br&gt;ai_draft_responses&lt;br&gt;ai_consent_records&lt;br&gt;urgency_alerts&lt;br&gt;ai_message_audit&lt;br&gt;visit_copilot_sessions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2967" y="400" width="350" height="180" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-ops" value="Security &amp;amp; Operations&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;roles&lt;br&gt;refresh_tokens&lt;br&gt;system_configs&lt;br&gt;processed_events&lt;br&gt;shedlock&lt;br&gt;audit_log&lt;br&gt;soft delete columns on appointments/notes/payments/invoices" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2577" y="610" width="350" height="180" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-relationships" value="Relationship Additions&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;users -&amp;gt; patient_profiles, refresh_tokens, user_consents&lt;br&gt;patients/doctors -&amp;gt; patient_access_grants, appointments&lt;br&gt;appointments -&amp;gt; payments, invoices, prescriptions, surveys, telemedicine_sessions, consultation_notes&lt;br&gt;doctors -&amp;gt; doctor_leaves, slot_blocks, reviews, departments/specializations&lt;br&gt;outbox_events -&amp;gt; Kafka topics; processed_events enforces idempote