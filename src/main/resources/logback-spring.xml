<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- ── Production profile: JSON structured logging ─────────────────────── -->
  <springProfile name="prod">
    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeContext>false</includeContext>
        <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
        <timeZone>UTC</timeZone>
        <!-- Inject OTel/Micrometer trace+span IDs so logs correlate with traces -->
        <mdcKeyFieldName>traceId:trace_id</mdcKeyFieldName>
        <mdcKeyFieldName>spanId:span_id</mdcKeyFieldName>
        <mdcKeyFieldName>correlationId:correlation_id</mdcKeyFieldName>
        <customFields>{"service":"medibook","env":"prod"}</customFields>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="JSON_STDOUT"/>
    </root>

    <logger name="com.medibook"            level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.hibernate.SQL"       level="WARN"/>
  </springProfile>

  <!-- ── All other profiles: human-readable console output ───────────────── -->
  <springProfile name="!prod">
    <appender name="PLAIN_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level [%X{traceId:- }/%X{spanId:- }] [%X{correlationId:-}] %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="PLAIN_STDOUT"/>
    </root>

    <logger name="com.medibook"            level="DEBUG"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.hibernate.SQL"       level="WARN"/>
  </springProfile>

</configuration>
