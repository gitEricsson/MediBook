      <mxCell id="codebase-additions-sequence-title" value="Sequence Extensions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2785" y="40" width="840" height="42" as="geometry" /></mxCell><mxCell id="codebase-additions-sequence-scope" value="Implemented runtime sequences that complement the original booking sequence." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="2785" y="92" width="840" height="78" as="geometry" /></mxCell><mxCell id="codebase-additions-sequence-hold" value="Appointment Hold / Booking&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;Patient -&amp;gt; AppointmentHoldController: POST /appointments/holds&lt;br&gt;AppointmentHoldService -&amp;gt; Redis: SET TTL 60s&lt;br&gt;Patient -&amp;gt; PatientAppointmentController: POST /appointments&lt;br&gt;AppointmentService -&amp;gt; MySQL: insert appointment with unique slot key&lt;br&gt;AppointmentEventProducer -&amp;gt; outbox_events: enqueue after commit" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2785" y="190" width="390" height="220" as="geometry" /></mxCell><mxCell id="codebase-additions-sequence-pay" value="Payment Lifecycle&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;Patient -&amp;gt; PaymentController: POST /payments&lt;br&gt;PaymentService -&amp;gt; PaymentProviderPort: initialize transaction&lt;br&gt;Provider -&amp;gt; WebhookController: POST /payments/webhooks/{provider}&lt;br&gt;WebhookProcessingService -&amp;gt; payment_webhook_events: idempotency check&lt;br&gt;PaymentEventConsumer / RefundEventConsumer: update downstream state" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="3210" y="190" width="390" height="220" as="geometry" /></mxCell><mxCell id="codebase-additions-sequence-tele" value="Telemedicine Visit&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;Doctor/Patient -&amp;gt; TelemedicineController: start/join/end&lt;br&gt;TelemedicineCallService -&amp;gt; VideoRoomPort: create room/token&lt;br&gt;Twilio/Daily -&amp;gt; Backend: webhook/status updates&lt;br&gt;Chat messages -&amp;gt; Cassandra and/or chat_messages&lt;br&gt;VisitCopilotService -&amp;gt; AI provider: transcript, brief, finalize" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2785" y="450" width="390" height="220" as="geometry" /></mxCell><mxCell id="codebase-additions-sequence-ai" value="AI Support / Urgency&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;User -&amp;gt; AiSupportController or ChatController&lt;br&gt;SafetyClassifier + SupportMessageClassifier route intent&lt;br&gt;AiSupportService -&amp;gt; Claude/Gemini/Ollama/stub provider&lt;br&gt;ChatEventProducer -&amp;gt; outbox_events: AI, chat, urgency topics&lt;br&gt;ChatEventConsumer -&amp;gt; notification/audit side effects" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="3210" y="450" width="390" height="220" as="geometry" /></mxCell></root>
