      <mxCell id="codebase-additions-erd-title" value="Codebase ERD Extensions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2577" y="40" width="760" height="42" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-scope" value="Added from source scan: entities and migrations beyond the original appointment-booking MVP." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1"><mxGeometry x="2577" y="92" width="760" height="78" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-care" value="Care Records &amp;amp; Access&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;patient_profiles&lt;br&gt;patient_access_grants&lt;br&gt;user_consents&lt;br&gt;consultation_surveys&lt;br&gt;prescriptions&lt;br&gt;doctor_reviews" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2577" y="190" width="350" height="180" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-schedule" value="Scheduling Controls&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;appointment_series&lt;br&gt;doctor_leaves&lt;br&gt;hospital_holidays&lt;br&gt;note_templates&lt;br&gt;doctor_slot_blocks&lt;br&gt;waitlist_entries" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2967" y="190" width="350" height="180" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-billing" value="Payments &amp;amp; Billing&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;payments&lt;br&gt;invoices&lt;br&gt;invoice_line_items&lt;br&gt;payment_webhook_events&lt;br&gt;pricing_policy&lt;br&gt;sequences&lt;br&gt;outbox_events" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2577" y="400" width="350" height="180" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-virtual" value="Telemedicine, Chat &amp;amp; AI&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;telemedicine_sessions&lt;br&gt;call_participants&lt;br&gt;chat_messages&lt;br&gt;chat_conversations&lt;br&gt;ai_draft_responses&lt;br&gt;ai_consent_records&lt;br&gt;urgency_alerts&lt;br&gt;ai_message_audit&lt;br&gt;visit_copilot_sessions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2967" y="400" width="350" height="180" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-ops" value="Security &amp;amp; Operations&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;roles&lt;br&gt;refresh_tokens&lt;br&gt;system_configs&lt;br&gt;processed_events&lt;br&gt;shedlock&lt;br&gt;audit_log&lt;br&gt;soft delete columns on appointments/notes/payments/invoices" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2577" y="610" width="350" height="180" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-relationships" value="Relationship Additions&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;users -&amp;gt; patient_profiles, refresh_tokens, user_consents&lt;br&gt;patients/doctors -&amp;gt; patient_access_grants, appointments&lt;br&gt;appointments -&amp;gt; payments, invoices, prescriptions, surveys, telemedicine_sessions, consultation_notes&lt;br&gt;doctors -&amp;gt; doctor_leaves, slot_blocks, reviews, departments/specializations&lt;br&gt;outbox_events -&amp;gt; Kafka topics; processed_events enforces idempotency" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2577" y="820" width="760" height="170" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-care-schedule" value="appointments/patients" style="endArrow=block;html=1;rounded=0;strokeColor=#475569;fontColor=#334155;fontSize=11;" parent="1" edge="1" source="codebase-additions-erd-care" target="codebase-additions-erd-schedule"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-schedule-billing" value="appointment fee lifecycle" style="endArrow=block;html=1;rounded=0;strokeColor=#475569;fontColor=#334155;fontSize=11;" parent="1" edge="1" source="codebase-additions-erd-schedule" target="codebase-additions-erd-billing"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-billing-virtual" value="paid virtual care" style="endArrow=block;html=1;rounded=0;strokeColor=#475569;fontColor=#334155;fontSize=11;" parent="1" edge="1" source="codebase-additions-erd-billing" target="codebase-additions-erd-virtual"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-virtual-care" value="clinical notes, prescriptions, consent" style="endArrow=block;html=1;rounded=0;strokeColor=#475569;fontColor=#334155;fontSize=11;" parent="1" edge="1" source="codebase-additions-erd-virtual" target="codebase-additions-erd-care"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="codebase-additions-erd-ops-all" value="audit, jobs, idempotency" style="endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#64748B;fontColor=#334155;fontSize=11;" parent="1" edge="1" source="codebase-additions-erd-ops" target="codebase-additions-erd-relationships"><mxGeometry relative="1" as="geometry" /></mxCell></root>
