# MediBook — Environment Variables
# Copy to .env and fill in production values before deploying

OPENAPI_ENABLED=true

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=medibook-super-secret-key-must-be-at-least-256-bits-long-for-hs256

# ─── PHI Encryption ─────────────────────────────────────
PHI_ENCRYPTION_KEY=medibook-phi-aes256-encryption-key!

# ─── Database ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
MEDIBOOK_DB_HOST=localhost
MEDIBOOK_DB_PORT=3307
MEDIBOOK_DB_NAME=medibook
MEDIBOOK_DB_USER=medibook
MEDIBOOK_DB_PASSWORD=medibook
DB_HOST=localhost
DB_PORT=3307
DB_NAME=medibook
DB_USER=medibook
DB_PASSWORD=medibook

# ─── Cassandra ──────────────────────────────────────────
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=medibook
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=cassandra

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka ──────────────────────────────────────────────
MEDIBOOK_KAFKA_BROKERS=localhost:29092
KAFKA_BROKERS=localhost:29092

# ─── Email (SMTP) ───────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM_ADDRESS=noreply@medibook.local
MAIL_FROM_NAME=MediBook
APP_MAIL_FAILOVER_ENABLED=true
BREVO_ENABLED=false
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_BASE_URL=https://api.brevo.com

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Payment Providers ───────────────────────────────────
# Paystack (enabled by default, set secret key for production)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Flutterwave (set FLUTTERWAVE_ENABLED=true to enable)
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key_here

# Stripe (set STRIPE_ENABLED=true to enable)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ─── Telemedicine Video Provider ─────────────────────────
# Options: stub (default, no video), daily-co, twilio
TELEMEDICINE_PROVIDER=stub

# Daily.co (set TELEMEDICINE_PROVIDER=daily-co to enable)
DAILY_CO_API_KEY=your_daily_co_api_key_here

# Twilio Video (set TELEMEDICINE_PROVIDER=twilio to enable)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret_here
TWILIO_VIDEO_ROOM_TYPE=group
TWILIO_VIDEO_TOKEN_TTL_SECONDS=900
TWILIO_VIDEO_STATUS_CALLBACK_URL=

# ─── AI / Clinical NLP ───────────────────────────────────
# Options: stub (default), claude-api, aws-comprehend
INTELLIGENCE_NLP_PROVIDER=stub
# Claude API (set INTELLIGENCE_NLP_PROVIDER=claude-api)
CLAUDE_API_KEY=sk-ant-your_claude_api_key_here

# ─── Super Admin Bootstrap ────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@hospital.example.com
SUPER_ADMIN_PASSWORD=Change_Me_In_Production_1!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PHONE=

# â”€â”€â”€ k6 Load Testing â”€â”€â”€
# Leave K6_TESTID blank to auto-generate a timestamped run id.
K6_TESTID=
K6_BASE_URL=http://app:8080
K6_USERNAME=patient.james@medibook.local
K6_PASSWORD=Password123!
K6_START_RATE=5
K6_TARGET_RATE=20
K6_PRE_ALLOCATED_VUS=30
K6_MAX_VUS=120
K6_WARMUP_DURATION=30s
K6_RAMP_UP_DURATION=1m
K6_STEADY_STATE_DURATION=3m
K6_RAMP_DOWN_DURATION=30s
K6_P99_THRESHOLD_MS=750
K6_SEARCH_P99_THRESHOLD_MS=1000
K6_PROMETHEUS_RW_SERVER_URL=http://prometheus:9090/api/v1/write

# Gatling Load Testing
GATLING_BASE_URL=http://app:8080
GATLING_USERNAME=patient.james@medibook.local
GATLING_PASSWORD=Password123!
GATLING_START_RATE=5
GATLING_TARGET_RATE=20
GATLING_WARMUP_SECONDS=30
GATLING_RAMP_UP_SECONDS=60
GATLING_STEADY_STATE_SECONDS=180
GATLING_RAMP_DOWN_SECONDS=30
GATLING_P99_THRESHOLD_MS=750
GATLING_SEARCH_P99_THRESHOLD_MS=1000

# ─── Monnify Payment Gateway ─────────────────────────────────────────────
MONNIFY_ENABLED=false
# Sandbox keys from https://app.monnify.com/developer/sdk
MONNIFY_API_KEY=MK_TEST_your_api_key_here
MONNIFY_SECRET_KEY=your_monnify_secret_key_here
MONNIFY_CONTRACT_CODE=your_contract_code_here
# Sandbox: https://sandbox.monnify.com  |  Live: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_REDIRECT_URL=http://localhost:3000/payment/callback
